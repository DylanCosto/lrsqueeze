+#[test]
+fn homopolymer_flank_widens_protection() -> anyhow::Result<()> {
+    let dir = tempfile::tempdir()?;
+    write_inputs(dir.path(), SAM)?;
+    let text = toml::to_string(&Policy::preset(Platform::Ont, Mode::Safe))?.replace(
+        "preserve_homopolymers = 5",
+        "preserve_homopolymers = 5\nhomopolymer_flank = 2",
+    );
+    let mut opts = options(dir.path(), Mode::Safe, Format::Cram);
+    opts.custom_policy = Some(toml::from_str(&text)?);
+    pack::pack(&opts)?;
+    let records = read_cram(dir.path())?;
+    // The A run (query 2..=8) and 2 bases on each side keep Q13.
+    let mut want = vec![12; 12];
+    want[..=10].fill(13);
+    assert_eq!(quals(&records[0]), want);
+    Ok(())
+}
