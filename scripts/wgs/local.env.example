# Copy to scripts/wgs/local.env (untracked) and fill in; the environment overrides it. Only what
# a script uses is needed.

W=${W:-/path/to/work} # work directory: archives, calls, eval, logs (~1 TB)
TOOLS_BIN=${TOOLS_BIN:-} # optional: a directory with rtg, bcftools, tabix, samtools
LRPIPE=${LRPIPE:-lrpipe} # lrpipe (snv: Clair3 port; sv: Sniffles2 port)
MODELS=${MODELS:-/path/to/clair3/models} # holds r1041_e82_400bps_{sup,hac}_v500 and hifi_revio

# ONT HG003, Dorado SUP v5.0 (GIAB HG003 v4.2.1)
ONT_BAM=${ONT_BAM:-/path/to/hg003.ont.sup.bam}
ONT_REF=${ONT_REF:-/path/to/GRCh38.fa} # the reference the ONT BAMs are aligned to
ONT_TRUTH=${ONT_TRUTH:-/path/to/HG003_GRCh38_1_22_v4.2.1_benchmark.vcf.gz}
ONT_AUTOSOMES_BED=${ONT_AUTOSOMES_BED:-/path/to/hg003.confident.autosomes.bed}
ONT_PRIMARY_BED=${ONT_PRIMARY_BED:-/path/to/hg003.confident.autosomes.no_chr20.bed}
ONT_LONGHP_BED=${ONT_LONGHP_BED:-/path/to/hg003.confident.long_homopolymers.bed}

# ONT HG002 HAC v5.0, chr1-6
ONT_HAC_BAM=${ONT_HAC_BAM:-/path/to/hg002.ont.hac.chr1-6.bam}

# PacBio HG002 (GIAB HG002 v4.2.1)
PB_REF=${PB_REF:-/path/to/GRCh38_no_alt.fa}
PB_BAM=${PB_BAM:-/path/to/hg002.hifi.bam} # HiFi, without rq/MM/ML
PB_REVIO_BAM=${PB_REVIO_BAM:-/path/to/hg002.revio.bam}
PB_TRUTH=${PB_TRUTH:-/path/to/HG002_GRCh38_1_22_v4.2.1_benchmark.vcf.gz}
PB_BED=${PB_BED:-/path/to/HG002_GRCh38_1_22_v4.2.1_benchmark_noinconsistent.bed}
